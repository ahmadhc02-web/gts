RADIUS_PORT=3002

# Required: 32+ character random secret for signing Radius JWT tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RADIUS_JWT_SECRET=

# Required: 64 hex characters (32 bytes) AES-256-GCM encryption key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RADIUS_ENC_KEY=

# Required: Supabase project URL and service role key (from Supabase Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 only if local/self-signed TLS certificates are used
RADIUS_SUPABASE_INSECURE_TLS=0
